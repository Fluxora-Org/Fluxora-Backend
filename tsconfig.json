
{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "ignoreDeprecations": "5.0",
    "types": ["node", "vitest/globals"]
  },
  "include": ["src/**/*", "migrations/**/*", "tests/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    // Test sources are executed by Vitest. The production typecheck gate covers
    // application and migration sources; several historical integration fixtures
    // intentionally model obsolete dependency interfaces and are not part of
    // this production-source gate.
    // Pre-existing syntax error from upstream PR #1357 (Fix/auth token verification), unrelated to #1254; no importers, safe to exclude.
    "tests/auth_protected.test.ts",
    // Standalone test file with no importers; safe to exclude from this boundary.
    "tests/indexer/catchupTelemetry.test.ts",
    "tests"
  ]
}
