
{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "types": ["node", "vitest/globals"]
  },
  "include": ["src/**/*", "migrations/**/*", "tests/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    // Standalone test file with no importers; safe to exclude from this boundary.
    "tests/indexer/catchupTelemetry.test.ts"
  ]
}
